# Servidor
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=troque_por_chave_segura_de_64_chars
JWT_EXPIRES_IN=8h

# SQLite
SQLITE_PATH=./database/ponto.db

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_KEY=sua_service_key_aqui

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://187.77.248.208:8080
EVOLUTION_API_KEY=sua_api_key_aqui
EVOLUTION_INSTANCE=oficina

# N8N
N8N_URL=http://187.77.248.208:5678
N8N_WEBHOOK_PONTO=http://187.77.248.208:5678/webhook/ponto-alerta

# Empresa
EMPRESA_NOME=Centro Automotivo Aliança
EMPRESA_CNPJ=00.000.000/0001-00
EMPRESA_ENDERECO=Porto Alegre, RS
EMPRESA_TELEFONE=(51) 99999-9999

# Criptografia LGPD
ENCRYPTION_KEY=troque_por_chave_aes256_de_32_chars

# Fuso horário
TZ=America/Sao_Paulo

# Tolerância de ponto (minutos)
TOLERANCIA_ENTRADA=5
TOLERANCIA_SAIDA=5
ALERTA_ATRASO_MIN=15
ALERTA_JORNADA_ABERTA_H=10
